# Optional local overrides; defaults are committed per Vite mode.
# Development uses /api/ through Vite's Unix-socket proxy.
VITE_API_BASE_URL=/api/
# Server-only path, resolved relative to frontend/; Python must be running.
WAZIFARM_API_SOCKET=../proxy.sock
# Production uses ../api/ under /apps/<app>/ui/; do not copy it into dev overrides.
